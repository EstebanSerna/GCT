# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys),
# usada por el asistente de IA del sitio (server/chatHandler.mjs). Nunca la
# subas al repositorio: copia este archivo como ".env" y pega tu clave ahí.
# En producción (Railway) se configura como variable de entorno del
# servicio, no en un archivo .env.
ANTHROPIC_API_KEY=

# Conexión a la base de datos Postgres (empleados, sesiones, asistencia).
# En Railway se configura sola como referencia a la base de datos del
# proyecto — no hace falta tocarla manualmente ahí.
DATABASE_URL=

# Ubicación de la oficina, para verificar que el empleado marcó entrada/
# salida desde ahí. Copia las coordenadas desde Google Maps (clic derecho
# sobre el punto exacto → clic en las coordenadas para copiarlas).
OFFICE_LAT=
OFFICE_LNG=
# Radio de tolerancia en metros (por defecto 150 si se deja vacío).
OFFICE_RADIUS_METERS=150

# Solo necesario para el build de producción que se sube a HostCarriel:
# URLs completas del backend desplegado en Railway. En local se dejan
# vacías y todo usa la misma URL relativa que sirve Vite en desarrollo.
VITE_CHAT_API_URL=
VITE_API_BASE_URL=

# Backend en Railway: orígenes desde los que se puede llamar la API
# (separados por coma). Por defecto ya incluye www.gct.com.co y localhost.
ALLOWED_ORIGINS=
